function init() {
    if (renderer) {
        return;
    }
    
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);
    scene.fog = new THREE.FogExp2(0x000000, 0.002);
    camera = new THREE.PerspectiveCamera(90, window.innerWidth / window.innerHeight, 0.1, 1000);
    
    const existingCanvases = document.querySelectorAll('canvas');
    existingCanvases.forEach(canvas => {
        const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
        if (gl && gl.getExtension('WEBGL_lose_context')) {
            gl.getExtension('WEBGL_lose_context').loseContext();
        }
        canvas.remove();
    });
    
    setTimeout(() => {
        try {
            renderer = new THREE.WebGLRenderer({ 
                antialias: true, 
                alpha: false,
                preserveDrawingBuffer: false,
                powerPreference: "high-performance"
            });
            renderer.setClearColor(0x000000, 1);
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.domElement.id = 'arweave-monolith-canvas';
            document.body.appendChild(renderer.domElement);
            
            completeInit();
            
        } catch (error) {
            console.error('WebGL initialization failed:', error);
            const fallbackDiv = document.createElement('div');
            fallbackDiv.innerHTML = '<h2 style="color: white; text-align: center; margin-top: 50px;">WebGL not supported. Please refresh the page or use a different browser.</h2>';
            document.body.appendChild(fallbackDiv);
            return;
        }
    }, 100);
}

function completeInit() {
    const ambientLight = new THREE.AmbientLight(0x404040, 2);
    scene.add(ambientLight);

    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.5);
    directionalLight.position.set(1, 1, 1);
    scene.add(directionalLight);

    monolith = new THREE.Group();
    monolith.position.set(0, 0, 0); 
    scene.add(monolith);

    camera.position.set(120, 20, 160);
    camera.lookAt(0, 0, 0); 

    const listener = new THREE.AudioListener();
    camera.add(listener);

    // Picking
    raycaster = new THREE.Raycaster();
    mouse = new THREE.Vector2();

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mouseup', onMouseUp);
    document.addEventListener('click', onMouseClick);

    window.addEventListener('resize', onWindowResize);

    window.addEventListener('wheel', onMouseWheel, { passive: false });
    document.getElementById('prev-day').addEventListener('click', () => {
        currentlyDisplayedDate.setDate(currentlyDisplayedDate.getDate() - 1);
        requestDayData(currentlyDisplayedDate);
    });
    document.getElementById('next-day').addEventListener('click', () => {
        currentlyDisplayedDate.setDate(currentlyDisplayedDate.getDate() + 1);
        requestDayData(currentlyDisplayedDate);
    });
    document.getElementById('search-input').addEventListener('input', onSearchInput);
    document.getElementById('search-clear').addEventListener('click', onSearchClear);
    document.getElementById('search-submit').addEventListener('click', onSearchSubmit);
    document.getElementById('content-preview-panel-close').addEventListener('click', closeContentPreview);
    document.getElementById('block-info-panel-close').addEventListener('click', closeBlockInfo);
    document.getElementById('loading-progress-cancel').addEventListener('click', onCancelLoading);

    // Initialize date
    currentlyDisplayedDate = new Date();
    currentlyDisplayedDate.setHours(0, 0, 0, 0);
    requestDayData(currentlyDisplayedDate);

    animate();
}

function animate() {
    requestAnimationFrame(animate);
    if (isRotating && monolith) {
        monolith.rotation.y += 0.002;
    }

    if (renderer && scene && camera) {
        renderer.render(scene, camera);
    }
}

function connectWebSocket() {
    const wsProtocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
    const wsUrl = `${wsProtocol}://${window.location.hostname}:${window.location.port || '3001'}`;
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
        console.log('WebSocket connection established.');
        requestDayData(currentlyDisplayedDate);
    }

    ws.onmessage = (event) => {
        const message = JSON.parse(event.data);
        switch (message.type) {
            case 'newBlock':
                addNewBlock(message.data);
                break;
            case 'loadingStatus':
                {
                    let progress = 0;
                    if (message.startHeight && message.currentHeight) {
                        progress = ((message.currentHeight - message.startHeight) / (message.endHeight - message.startHeight)) * 100;
                    }

                    updateLoadingProgress(progress, message.message);
                }
                break;
            case 'dayStreamComplete':
                updateLoadingProgress(100, 'Stream complete.');
                setTimeout(hideLoadingProgress, 1000);
                break;
            case 'error':
                console.error('Server error:', message.message);
                updateLoadingProgress(100, `Error: ${message.message}`);
                break;
        }
    }
    if (!panel || !group) return;
    const h = group.userData.blockHeight;
    const txs = group.userData.transactions || [];
    const totalSize = group.userData.totalSize || 0;
    const heightEl = document.getElementById('block-height');
    const txCountEl = document.getElementById('block-tx-count');
    const sizeEl = document.getElementById('block-total-size');
    if (heightEl) heightEl.textContent = String(h);
    if (txCountEl) txCountEl.textContent = String(txs.length);
    if (sizeEl) sizeEl.textContent = formatBytes(totalSize);

    // List transactions
    const list = document.getElementById('transaction-list');
    if (list) {
        list.innerHTML = '';
        txs.slice(0, 50).forEach(tx => {
            const li = document.createElement('div');
            const ct = (tx.tags && (tx.tags['Content-Type'] || tx.tags['content-type'])) || '-';
            li.textContent = `${tx.id.slice(0, 6)}…${tx.id.slice(-6)}  ${formatBytes(parseInt(tx.data_size||'0',10))}  ${ct}`;
            list.appendChild(li);
        });
    }

    // Preview first image if present
    const imgTx = txs.find(t => {
        const ct = t.tags && (t.tags['Content-Type'] || t.tags['content-type']);
        return ct && typeof ct === 'string' && ct.startsWith('image/');
    });
    const previewPanel = document.getElementById('content-preview-panel');
    const display = document.getElementById('content-display');
    if (display) {
        display.innerHTML = '';
        if (imgTx) {
            const img = document.createElement('img');
            img.src = `https://arweave.net/${imgTx.id}`;
