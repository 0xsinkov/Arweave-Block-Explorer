    if (!hoveredBlock) {
        if (tooltip) tooltip.style.display = 'none';
        return;
    }
    const outline = hoveredBlock.children.find(c => c.type === 'LineSegments');
    const style = contentTypeDataStyles[hoveredBlock.userData.dominantType] || { outlineColor: 0xffffff };
    if (outline) outline.material.color.set(style.outlineColor);

    // Tooltip content and position
    const h = hoveredBlock.userData.blockHeight;
    const txs = hoveredBlock.userData.transactions || [];
    const totalSize = hoveredBlock.userData.totalSize || 0;
    if (tooltip) {
        tooltip.innerText = `Height: ${h}\nTx: ${txs.length}\nSize: ${formatBytes(totalSize)}`;
        tooltip.style.left = `${event.clientX + 12}px`;
        tooltip.style.top = `${event.clientY + 12}px`;
        tooltip.style.display = 'block';
    }
}

function showBlockInfo(group) {
    const panel = document.getElementById('block-info-panel');
    if (!panel || !group) return;
    const h = group.userData.blockHeight;
    const txs = group.userData.transactions || [];
    const totalSize = group.userData.totalSize || 0;
    const heightEl = document.getElementById('block-height');
    const txCountEl = document.getElementById('block-tx-count');
    const sizeEl = document.getElementById('block-total-size');
    if (heightEl) heightEl.textContent = String(h);
    if (txCountEl) txCountEl.textContent = String(txs.length);
    if (sizeEl) sizeEl.textContent = formatBytes(totalSize);

    // List transactions
    const list = document.getElementById('transaction-list');
    if (list) {
        list.innerHTML = '';
        txs.slice(0, 50).forEach(tx => {
            const li = document.createElement('div');
            const ct = (tx.tags && (tx.tags['Content-Type'] || tx.tags['content-type'])) || '-';
            li.textContent = `${tx.id.slice(0, 6)}…${tx.id.slice(-6)}  ${formatBytes(parseInt(tx.data_size||'0',10))}  ${ct}`;
            list.appendChild(li);
        });
    }

    // Preview first image if present
    const imgTx = txs.find(t => {
        const ct = t.tags && (t.tags['Content-Type'] || t.tags['content-type']);
        return ct && typeof ct === 'string' && ct.startsWith('image/');
    });
    const previewPanel = document.getElementById('content-preview-panel');
    const display = document.getElementById('content-display');
    if (display) {
        display.innerHTML = '';
        if (imgTx) {
            const img = document.createElement('img');
            img.src = `https://arweave.net/${imgTx.id}`;
            img.alt = imgTx.id;
            img.style.maxWidth = '100%';
            img.style.maxHeight = '60vh';
            img.loading = 'lazy';
            img.onerror = () => { img.replaceWith(document.createTextNode('Preview unavailable')); };
            display.appendChild(img);
            if (previewPanel) previewPanel.style.display = 'block';
        }
    }

    panel.style.display = 'block';
}

function closeBlockInfo() {
    const panel = document.getElementById('block-info-panel');
    if (panel) panel.style.display = 'none';
}

function closeContentPreview() {
    const panel = document.getElementById('content-preview-panel');
    if (panel) panel.style.display = 'none';
}

// Fit camera to current monolith bounds
function fitCameraToMonolith() {
    if (!camera || !monolith) return;
    const box = new THREE.Box3().setFromObject(monolith);
    if (!box.isEmpty()) {
        const size = new THREE.Vector3();
        const center = new THREE.Vector3();
        box.getSize(size);
        box.getCenter(center);

        const maxDim = Math.max(size.x, size.y, size.z);
        const fov = camera.fov * (Math.PI / 180);
        let distance = maxDim / (2 * Math.tan(fov / 2));
        distance *= 1.4; // add some padding

        // Position camera on a slight angle from center
        camera.position.set(center.x + distance, center.y + distance * 0.15, center.z + distance);
        camera.lookAt(center);
        camera.updateProjectionMatrix();
    }
}

