function requestDayData(date) {
    if (ws.readyState === WebSocket.OPEN) {
        clearMonolith();
        showLoadingProgress();
        updateLoadingProgress(0, 'Requesting data for new date...');
        const dateString = date.toISOString().split('T')[0];
        document.getElementById('date-display').textContent = date.toDateString();
        ws.send(JSON.stringify({ type: 'get_day', date: dateString }

